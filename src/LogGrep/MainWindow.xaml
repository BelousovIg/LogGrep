<Window x:Class="LogGrep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LogGrep.ViewModels"
        xmlns:ctl="clr-namespace:LogGrep.Controls"
        Title="LogGrep — WoW combat log splitter"
        Icon="Assets/app.ico"
        Height="760" Width="1280"
        MinHeight="480" MinWidth="980"
        Background="{StaticResource WindowBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== toolbar ===== -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Open log"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding OpenCommand}" />

                <TextBox Grid.Column="1"
                         Margin="12,0,12,0"
                         IsReadOnly="True"
                         Text="{Binding LogPath, Mode=OneWay}"
                         ToolTip="{Binding LogPath}" />

                <Button Grid.Column="2"
                        Content="Settings"
                        Margin="0,0,12,0"
                        MinWidth="96"
                        Height="32"
                        Click="OnOpenSettings"
                        ToolTip="Where things are kept, and the Blizzard client the rules are built with" />

                <Button Grid.Column="3"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" />

        <!-- ===== table header ===== -->
        <Border Grid.Row="2" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="16,0,16,0" Height="34">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource ColToggle}" />
                    <ColumnDefinition Width="{StaticResource ColCheck}" />
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=EncounterName}" MinWidth="150" />
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=EncounterDifficulty}" MinWidth="60" />
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=EncounterPulls}" MinWidth="60" />
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=EncounterResult}" MinWidth="60" />
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=EncounterParty}" MinWidth="60" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=EncounterMistakes}" MinWidth="60" />
                </Grid.ColumnDefinitions>

                <ctl:SortHeader Grid.Column="2" Column="Name" Title="ENCOUNTER"
                                Sort="{Binding Sorting.Encounters}" />
                <ctl:SortHeader Grid.Column="3" Column="Difficulty" Title="DIFFICULTY"
                                Sort="{Binding Sorting.Encounters}" />
                <ctl:SortHeader Grid.Column="4" Column="Pulls" Title="PULLS"
                                Sort="{Binding Sorting.Encounters}"
                                HorizontalContentAlignment="Right" Padding="0,0,14,0" />
                <ctl:SortHeader Grid.Column="5" Column="Result" Title="RESULT"
                                Sort="{Binding Sorting.Encounters}"
                                HorizontalContentAlignment="Right" Padding="0,0,14,0" />
                <ctl:SortHeader Grid.Column="6" Column="Party" Title="PARTY SIZE"
                                Sort="{Binding Sorting.Encounters}"
                                HorizontalContentAlignment="Right" Padding="0,0,14,0"
                                ToolTip="Largest group size seen across the attempts" />
                <ctl:SortHeader Grid.Column="7" Column="Mistakes" Title="MISTAKES"
                                Sort="{Binding Sorting.Encounters}"
                                HorizontalContentAlignment="Right" Padding="0,0,14,0"
                                ToolTip="Attempts with a mechanic taken by the wrong role, out of all attempts" />

                <GridSplitter Grid.Column="2" Style="{StaticResource ColumnSplitter}" />
                <GridSplitter Grid.Column="3" Style="{StaticResource ColumnSplitter}" />
                <GridSplitter Grid.Column="4" Style="{StaticResource ColumnSplitter}" />
                <GridSplitter Grid.Column="5" Style="{StaticResource ColumnSplitter}" />
                <GridSplitter Grid.Column="6" Style="{StaticResource ColumnSplitter}" />
            </Grid>
        </Border>

        <!-- ===== encounters ===== -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="16,0,16,0">
            <ItemsControl ItemsSource="{Binding EncountersView}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,2">

                            <!-- encounter row -->
                            <Border Background="{StaticResource RowBrush}" CornerRadius="5" Height="38">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource ColToggle}" />
                                        <ColumnDefinition Width="{StaticResource ColCheck}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=EncounterName}" MinWidth="150" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=EncounterDifficulty}" MinWidth="60" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=EncounterPulls}" MinWidth="60" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=EncounterResult}" MinWidth="60" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=EncounterParty}" MinWidth="60" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=EncounterMistakes}" MinWidth="60" />
                                    </Grid.ColumnDefinitions>

                                    <ToggleButton Grid.Column="0"
                                                  Style="{StaticResource ExpanderToggle}"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsExpandable}"
                                                  ToolTip="Show the pulls of this encounter" />

                                    <CheckBox Grid.Column="1"
                                              IsThreeState="False"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              ToolTip="Select every pull of this encounter" />

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,12,0"
                                               ToolTip="{Binding Name}" />

                                    <TextBlock Grid.Column="3" Style="{StaticResource MutedText}" Text="{Binding DifficultyText}" />

                                    <TextBlock Grid.Column="4" Style="{StaticResource NumberText}" Text="{Binding PullCountText}" />

                                    <TextBlock x:Name="KillCell"
                                               Grid.Column="5"
                                               Style="{StaticResource NumberText}"
                                               Text="{Binding KillText}" />

                                    <TextBlock Grid.Column="6" Style="{StaticResource NumberText}" Text="{Binding PartySizeText}" />
                                    <TextBlock x:Name="MistakesCell"
                                               Grid.Column="7"
                                               Style="{StaticResource NumberText}"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="{Binding MistakesText}"
                                               ToolTip="Attempts with a mechanic taken by the wrong role, out of all attempts" />
                                </Grid>
                            </Border>

                            <!-- pulls -->
                            <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">

                                <Grid Height="26" Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource ColPullIndent}" />
                                        <ColumnDefinition Width="{StaticResource ColCheck}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullResult}" MinWidth="60" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullStart}" MinWidth="60" />
                                        <ColumnDefinition Width="*" MinWidth="40" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullDuration}" MinWidth="60" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullPlayers}" MinWidth="60" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullDps}" MinWidth="60" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullHps}" MinWidth="60" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullMistakes}" MinWidth="60" />
                                    </Grid.ColumnDefinitions>
                                    <ctl:SortHeader Grid.Column="2" Column="Result" Title="RESULT"
                                                    Sort="{Binding Sorting.Pulls}" />
                                    <ctl:SortHeader Grid.Column="3" Column="Started" Title="STARTED"
                                                    Sort="{Binding Sorting.Pulls}" />
                                    <ctl:SortHeader Grid.Column="5" Column="Duration" Title="DURATION"
                                                    Sort="{Binding Sorting.Pulls}"
                                                    HorizontalContentAlignment="Right" Padding="0,0,14,0" />
                                    <ctl:SortHeader Grid.Column="6" Column="Players" Title="PLAYERS"
                                                    Sort="{Binding Sorting.Pulls}"
                                                    HorizontalContentAlignment="Right" Padding="0,0,14,0" />
                                    <ctl:SortHeader Grid.Column="7" Column="Dps" Title="DPS"
                                                    Sort="{Binding Sorting.Pulls}"
                                                    HorizontalContentAlignment="Right" Padding="0,0,14,0" />
                                    <ctl:SortHeader Grid.Column="8" Column="Hps" Title="HPS"
                                                    Sort="{Binding Sorting.Pulls}"
                                                    HorizontalContentAlignment="Right" Padding="0,0,14,0" />
                                    <ctl:SortHeader Grid.Column="9" Column="Mistakes" Title="MISTAKES"
                                                    Sort="{Binding Sorting.Pulls}"
                                                    HorizontalContentAlignment="Right" Padding="0,0,14,0"
                                                    ToolTip="Mechanics taken by the wrong role during this attempt" />

                                    <GridSplitter Grid.Column="2" Style="{StaticResource ColumnSplitter}" />
                                    <GridSplitter Grid.Column="3" Style="{StaticResource ColumnSplitter}" />
                                    <GridSplitter Grid.Column="5" Style="{StaticResource ColumnSplitter}" />
                                    <GridSplitter Grid.Column="6" Style="{StaticResource ColumnSplitter}" />
                                    <GridSplitter Grid.Column="7" Style="{StaticResource ColumnSplitter}" />
                                    <GridSplitter Grid.Column="8" Style="{StaticResource ColumnSplitter}" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding PullsView}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <Border Background="{StaticResource SubRowBrush}" CornerRadius="4"
                                                        Height="32" Margin="0,0,0,2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{StaticResource ColPullIndent}" />
                                                            <ColumnDefinition Width="{StaticResource ColCheck}" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullResult}" MinWidth="60" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullStart}" MinWidth="60" />
                                                            <ColumnDefinition Width="*" MinWidth="40" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullDuration}" MinWidth="60" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullPlayers}" MinWidth="60" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullDps}" MinWidth="60" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullHps}" MinWidth="60" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullMistakes}" MinWidth="60" />
                                                        </Grid.ColumnDefinitions>

                                                        <ToggleButton Grid.Column="0"
                                                                      Style="{StaticResource ExpanderToggle}"
                                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                      IsEnabled="{Binding HasPlayers}"
                                                                      ToolTip="Show every player of this pull" />

                                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                                        <TextBlock x:Name="ResultCell"
                                                                   Grid.Column="2"
                                                                   Text="{Binding ResultText}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource DangerBrush}" />

                                                        <TextBlock Grid.Column="3" Style="{StaticResource MutedText}"
                                                                   Text="{Binding StartText}" />


                                                        <TextBlock Grid.Column="5" Style="{StaticResource NumberText}"
                                                                   Text="{Binding DurationText}" />
                                                        <TextBlock Grid.Column="6" Style="{StaticResource NumberText}"
                                                                   Text="{Binding ParticipantsText}" />
                                                        <TextBlock Grid.Column="7" Style="{StaticResource NumberText}"
                                                                   Text="{Binding DpsText}" />
                                                        <TextBlock Grid.Column="8" Style="{StaticResource NumberText}"
                                                                   Text="{Binding HpsText}" />
                                                        <TextBlock x:Name="PullMistakesCell"
                                                                   Grid.Column="9"
                                                                   Style="{StaticResource NumberText}"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   Text="{Binding MistakesText}"
                                                                   ToolTip="How many times somebody took a mechanic that was not theirs" />
                                                    </Grid>
                                                </Border>

                                                <!-- per player table of this pull -->
                                                <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">

                                                    <Grid Height="24">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{StaticResource ColRosterIndent}" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerName}" MinWidth="60" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerClass}" MinWidth="60" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerSpec}" MinWidth="60" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerDps}" MinWidth="60" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerHps}" MinWidth="60" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerDtps}" MinWidth="60" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerDied}" MinWidth="76" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerCauses}" MinWidth="150" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerMistakes}" MinWidth="80" />
                                                        </Grid.ColumnDefinitions>

                                                        <ctl:SortHeader Grid.Column="1" Column="Name" Title="PLAYER"
                                                                        Sort="{Binding Sorting.Players}" />
                                                        <ctl:SortHeader Grid.Column="2" Column="Class" Title="CLASS"
                                                                        Sort="{Binding Sorting.Players}" />
                                                        <ctl:SortHeader Grid.Column="3" Column="Spec" Title="SPEC"
                                                                        Sort="{Binding Sorting.Players}" />
                                                        <ctl:SortHeader Grid.Column="4" Column="Dps" Title="DPS"
                                                                        Sort="{Binding Sorting.Players}"
                                                                        HorizontalContentAlignment="Right" Padding="0,0,14,0" />
                                                        <ctl:SortHeader Grid.Column="5" Column="Hps" Title="HPS"
                                                                        Sort="{Binding Sorting.Players}"
                                                                        HorizontalContentAlignment="Right" Padding="0,0,14,0" />
                                                        <ctl:SortHeader Grid.Column="6" Column="Dtps" Title="DTPS"
                                                                        Sort="{Binding Sorting.Players}"
                                                                        HorizontalContentAlignment="Right" Padding="0,0,14,0"
                                                                        ToolTip="Damage taken per second" />
                                                        <ctl:SortHeader Grid.Column="7" Column="Died" Title="DIED"
                                                                        Sort="{Binding Sorting.Players}"
                                                                        HorizontalContentAlignment="Right" Padding="0,0,14,0"
                                                                        ToolTip="Sorted by the first death. Reversed, survivors come first by name, then the latest deaths" />
                                                        <ctl:SortHeader Grid.Column="8" Column="Causes" Title="KILLED BY"
                                                                        Sort="{Binding Sorting.Players}"
                                                                        ToolTip="Damage taken over the last 10 seconds before each death" />
                                                        <ctl:SortHeader Grid.Column="9" Column="Mistakes" Title="MISTAKES"
                                                                        Sort="{Binding Sorting.Players}"
                                                                        ToolTip="Mechanics this player took that belong to another role" />

                                                        <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}" />
                                                        <GridSplitter Grid.Column="2" Style="{StaticResource ColumnSplitter}" />
                                                        <GridSplitter Grid.Column="3" Style="{StaticResource ColumnSplitter}" />
                                                        <GridSplitter Grid.Column="4" Style="{StaticResource ColumnSplitter}" />
                                                        <GridSplitter Grid.Column="5" Style="{StaticResource ColumnSplitter}" />
                                                        <GridSplitter Grid.Column="6" Style="{StaticResource ColumnSplitter}" />
                                                        <GridSplitter Grid.Column="7" Style="{StaticResource ColumnSplitter}" />
                                                        <GridSplitter Grid.Column="8" Style="{StaticResource ColumnSplitter}" />
                                                    </Grid>

                                                    <ItemsControl ItemsSource="{Binding PlayersView}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{StaticResource InputBrush}" CornerRadius="3"
                                                                        Height="26" Margin="0,0,0,1">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="{StaticResource ColRosterIndent}" />
                                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerName}" MinWidth="60" />
                                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerClass}" MinWidth="60" />
                                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerSpec}" MinWidth="60" />
                                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerDps}" MinWidth="60" />
                                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerHps}" MinWidth="60" />
                                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerDtps}" MinWidth="60" />
                                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerDied}" MinWidth="76" />
                                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerCauses}" MinWidth="150" />
                                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerMistakes}" MinWidth="80" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <Button Grid.Column="1"
                                                                                Style="{StaticResource NameButton}"
                                                                                Content="{Binding Name}"
                                                                                Margin="0,0,10,0"
                                                                                Click="OnCopyPlayerName"
                                                                                ToolTip="{Binding FullName}"
                                                                                AutomationProperties.Name="Copy the full name" />
                                                                        <!-- Sits in the indent column, which lines up under the
                                                                             checkbox of the attempt this table belongs to. -->
                                                                        <Path x:Name="RoleMark"
                                                                              Grid.Column="0"
                                                                              Width="11" Height="11"
                                                                              Stretch="Uniform"
                                                                              HorizontalAlignment="Right"
                                                                              VerticalAlignment="Center"
                                                                              Margin="0,0,8,0"
                                                                              Visibility="Collapsed" />

                                                                        <TextBlock Grid.Column="2" Style="{StaticResource MutedText}"
                                                                                   Text="{Binding ClassName}" Margin="0,0,10,0"
                                                                                   Foreground="{Binding ClassBrush}" />
                                                                        <TextBlock Grid.Column="3" Style="{StaticResource MutedText}"
                                                                                   Text="{Binding SpecName}" Margin="0,0,10,0" />
                                                                        <TextBlock Grid.Column="4" Style="{StaticResource NumberText}"
                                                                                   Text="{Binding DpsText}" />
                                                                        <TextBlock Grid.Column="5" Style="{StaticResource NumberText}"
                                                                                   Text="{Binding HpsText}" />
                                                                        <TextBlock Grid.Column="6" Style="{StaticResource NumberText}"
                                                                                   Text="{Binding DtpsText}" />
                                                                        <TextBlock x:Name="DiedCell"
                                                                                   Grid.Column="7"
                                                                                   Style="{StaticResource NumberText}"
                                                                                   Foreground="{StaticResource MutedBrush}"
                                                                                   Text="{Binding DeathsText}"
                                                                                   ToolTip="{Binding DeathsTooltip}"
                                                                                   ToolTipService.ShowDuration="60000" />
                                                                        <TextBlock Grid.Column="8"
                                                                                   Style="{StaticResource MutedText}"
                                                                                   Text="{Binding CausesText}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Margin="0,0,6,0"
                                                                                   ToolTip="{Binding CausesTooltip}"
                                                                                   ToolTipService.ShowDuration="60000" />
                                                                        <TextBlock x:Name="MistakesCell"
                                                                                   Grid.Column="9"
                                                                                   Style="{StaticResource MutedText}"
                                                                                   Text="{Binding MistakesText}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Margin="0,0,6,0"
                                                                                   ToolTip="{Binding MistakesTooltip}"
                                                                                   ToolTipService.ShowDuration="60000" />
                                                                    </Grid>
                                                                </Border>

                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding HasMistakes}" Value="True">
                                                                        <Setter TargetName="MistakesCell" Property="Foreground"
                                                                                Value="{StaticResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsTank}" Value="True">
                                                                        <Setter TargetName="RoleMark" Property="Visibility" Value="Visible" />
                                                                        <Setter TargetName="RoleMark" Property="Data"
                                                                                Value="{StaticResource TankShield}" />
                                                                        <Setter TargetName="RoleMark" Property="Fill"
                                                                                Value="{StaticResource TankBrush}" />
                                                                        <Setter TargetName="RoleMark" Property="ToolTip" Value="Tank" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsHealer}" Value="True">
                                                                        <Setter TargetName="RoleMark" Property="Visibility" Value="Visible" />
                                                                        <Setter TargetName="RoleMark" Property="Data"
                                                                                Value="{StaticResource HealerCross}" />
                                                                        <Setter TargetName="RoleMark" Property="Fill"
                                                                                Value="{StaticResource HealerBrush}" />
                                                                        <Setter TargetName="RoleMark" Property="ToolTip" Value="Healer" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Died}" Value="True">
                                                                        <Setter TargetName="DiedCell" Property="Foreground"
                                                                                Value="{StaticResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Border Height="8" Background="Transparent" />
                                                </StackPanel>
                                            </StackPanel>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasMistakes}" Value="True">
                                                    <Setter TargetName="PullMistakesCell" Property="Foreground"
                                                            Value="{StaticResource DangerBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                    <Setter TargetName="ResultCell" Property="Foreground"
                                                            Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="6" Background="Transparent" />
                            </StackPanel>
                        </StackPanel>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasMistakes}" Value="True">
                                <Setter TargetName="MistakesCell" Property="Foreground"
                                        Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasKill}" Value="True">
                                <Setter TargetName="KillCell" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasKill}" Value="False">
                                <Setter TargetName="KillCell" Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource LinkButton}" Content="Select all"
                        Command="{Binding SelectAllCommand}" />
                <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="Clear"
                        Command="{Binding SelectNoneCommand}" />
                <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="Expand all"
                        Command="{Binding ExpandAllCommand}" />
                <Button Grid.Column="3" Style="{StaticResource LinkButton}" Content="Collapse all"
                        Command="{Binding CollapseAllCommand}" />

                <!-- What the detectors found goes out as one file per player, which is how anybody
                     reads it: nobody wants the whole night, they want their own part of it. -->
                <Button Grid.Column="4" Style="{StaticResource LinkButton}" Content="Save report"
                        Command="{Binding ExportFindingsCommand}" ToolTip="{Binding FindingsSummary}" />

                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Left" Margin="16,0,0,0">
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Grid.Column="6" Style="{StaticResource MutedText}" Text="{Binding SelectionText}"
                           Margin="0,0,16,0" />

                <StackPanel Grid.Column="7" Orientation="Horizontal">
                    <CheckBox Content="as single file" IsChecked="{Binding AsSingleFile, Mode=TwoWay}"
                              Margin="0,0,16,0"
                              ToolTip="Write every selected pull into a single file" />
                    <Button Content="Export" Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
