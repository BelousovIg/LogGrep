<Window x:Class="LogGrep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LogGrep.ViewModels"
        Title="LogGrep — WoW combat log splitter"
        Icon="Assets/app.ico"
        Height="760" Width="1280"
        MinHeight="480" MinWidth="980"
        Background="{StaticResource WindowBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== toolbar ===== -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Open log"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding OpenCommand}" />

                <TextBox Grid.Column="1"
                         Margin="12,0,12,0"
                         IsReadOnly="True"
                         Text="{Binding LogPath, Mode=OneWay}"
                         ToolTip="{Binding LogPath}" />

                <Button Grid.Column="2"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" />

        <!-- ===== table header ===== -->
        <Border Grid.Row="2" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="16,0,16,0" Height="34">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource ColToggle}" />
                    <ColumnDefinition Width="{StaticResource ColCheck}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource ColDifficulty}" />
                    <ColumnDefinition Width="{StaticResource ColPulls}" />
                    <ColumnDefinition Width="{StaticResource ColKill}" />
                    <ColumnDefinition Width="{StaticResource ColParty}" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="2" Style="{StaticResource HeaderText}" Text="ENCOUNTER" />
                <TextBlock Grid.Column="3" Style="{StaticResource HeaderText}" Text="DIFFICULTY" />
                <TextBlock Grid.Column="4" Style="{StaticResource HeaderText}" Text="PULLS"
                           HorizontalAlignment="Right" Margin="0,0,14,0" />
                <TextBlock Grid.Column="5" Style="{StaticResource HeaderText}" Text="RESULT"
                           HorizontalAlignment="Right" Margin="0,0,14,0" />
                <TextBlock Grid.Column="6" Style="{StaticResource HeaderText}" Text="PARTY SIZE"
                           HorizontalAlignment="Right" Margin="0,0,14,0" />
            </Grid>
        </Border>

        <!-- ===== encounters ===== -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="16,0,16,0">
            <ItemsControl ItemsSource="{Binding Encounters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,2">

                            <!-- encounter row -->
                            <Border Background="{StaticResource RowBrush}" CornerRadius="5" Height="38">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource ColToggle}" />
                                        <ColumnDefinition Width="{StaticResource ColCheck}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{StaticResource ColDifficulty}" />
                                        <ColumnDefinition Width="{StaticResource ColPulls}" />
                                        <ColumnDefinition Width="{StaticResource ColKill}" />
                                        <ColumnDefinition Width="{StaticResource ColParty}" />
                                    </Grid.ColumnDefinitions>

                                    <ToggleButton Grid.Column="0"
                                                  Style="{StaticResource ExpanderToggle}"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsExpandable}"
                                                  ToolTip="Show the pulls of this encounter" />

                                    <CheckBox Grid.Column="1"
                                              IsThreeState="False"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              ToolTip="Select every pull of this encounter" />

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,12,0"
                                               ToolTip="{Binding Name}" />

                                    <TextBlock Grid.Column="3" Style="{StaticResource MutedText}" Text="{Binding DifficultyText}" />

                                    <TextBlock Grid.Column="4" Style="{StaticResource NumberText}" Text="{Binding PullCountText}" />

                                    <TextBlock x:Name="KillCell"
                                               Grid.Column="5"
                                               Style="{StaticResource NumberText}"
                                               Text="{Binding KillText}" />

                                    <TextBlock Grid.Column="6" Style="{StaticResource NumberText}" Text="{Binding PartySizeText}" />
                                </Grid>
                            </Border>

                            <!-- pulls -->
                            <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">

                                <Grid Height="26" Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource ColPullIndent}" />
                                        <ColumnDefinition Width="{StaticResource ColCheck}" />
                                        <ColumnDefinition Width="{StaticResource ColPullResult}" />
                                        <ColumnDefinition Width="{StaticResource ColPullStart}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{StaticResource ColPullCopy}" />
                                        <ColumnDefinition Width="{StaticResource ColPullDuration}" />
                                        <ColumnDefinition Width="{StaticResource ColPullPlayers}" />
                                        <ColumnDefinition Width="{StaticResource ColPullDps}" />
                                        <ColumnDefinition Width="{StaticResource ColPullHps}" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="2" Style="{StaticResource HeaderText}" Text="RESULT" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource HeaderText}" Text="STARTED" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource HeaderText}" Text="ROSTER" />
                                    <TextBlock Grid.Column="6" Style="{StaticResource HeaderText}" Text="DURATION"
                                               HorizontalAlignment="Right" Margin="0,0,14,0" />
                                    <TextBlock Grid.Column="7" Style="{StaticResource HeaderText}" Text="PLAYERS"
                                               HorizontalAlignment="Right" Margin="0,0,14,0" />
                                    <TextBlock Grid.Column="8" Style="{StaticResource HeaderText}" Text="DPS"
                                               HorizontalAlignment="Right" Margin="0,0,14,0" />
                                    <TextBlock Grid.Column="9" Style="{StaticResource HeaderText}" Text="HPS"
                                               HorizontalAlignment="Right" Margin="0,0,14,0" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Pulls}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <Border Background="{StaticResource SubRowBrush}" CornerRadius="4"
                                                        Height="32" Margin="0,0,0,2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{StaticResource ColPullIndent}" />
                                                            <ColumnDefinition Width="{StaticResource ColCheck}" />
                                                            <ColumnDefinition Width="{StaticResource ColPullResult}" />
                                                            <ColumnDefinition Width="{StaticResource ColPullStart}" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="{StaticResource ColPullCopy}" />
                                                            <ColumnDefinition Width="{StaticResource ColPullDuration}" />
                                                            <ColumnDefinition Width="{StaticResource ColPullPlayers}" />
                                                            <ColumnDefinition Width="{StaticResource ColPullDps}" />
                                                            <ColumnDefinition Width="{StaticResource ColPullHps}" />
                                                        </Grid.ColumnDefinitions>

                                                        <ToggleButton Grid.Column="0"
                                                                      Style="{StaticResource ExpanderToggle}"
                                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                      IsEnabled="{Binding HasPlayers}"
                                                                      ToolTip="Show every player of this pull" />

                                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                                        <TextBlock x:Name="ResultCell"
                                                                   Grid.Column="2"
                                                                   Text="{Binding ResultText}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource DangerBrush}" />

                                                        <TextBlock Grid.Column="3" Style="{StaticResource MutedText}"
                                                                   Text="{Binding StartText}" />

                                                        <TextBlock Grid.Column="4"
                                                                   Style="{StaticResource MutedText}"
                                                                   Text="{Binding Roster}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,0,6,0"
                                                                   ToolTip="{Binding RosterTooltip}"
                                                                   ToolTipService.ShowDuration="60000" />

                                                        <Button Grid.Column="5"
                                                                Style="{StaticResource IconButton}"
                                                                Command="{Binding CopyRosterCommand}"
                                                                AutomationProperties.Name="Copy roster"
                                                                ToolTip="Copy the full roster to the clipboard" />

                                                        <TextBlock Grid.Column="6" Style="{StaticResource NumberText}"
                                                                   Text="{Binding DurationText}" />
                                                        <TextBlock Grid.Column="7" Style="{StaticResource NumberText}"
                                                                   Text="{Binding ParticipantsText}" />
                                                        <TextBlock Grid.Column="8" Style="{StaticResource NumberText}"
                                                                   Text="{Binding DpsText}" />
                                                        <TextBlock Grid.Column="9" Style="{StaticResource NumberText}"
                                                                   Text="{Binding HpsText}" />
                                                    </Grid>
                                                </Border>

                                                <!-- per player table of this pull -->
                                                <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">

                                                    <Grid Height="24">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{StaticResource ColRosterIndent}" />
                                                            <ColumnDefinition Width="{StaticResource ColRosterName}" />
                                                            <ColumnDefinition Width="{StaticResource ColRosterClass}" />
                                                            <ColumnDefinition Width="{StaticResource ColRosterSpec}" />
                                                            <ColumnDefinition Width="{StaticResource ColRosterDps}" />
                                                            <ColumnDefinition Width="{StaticResource ColRosterHps}" />
                                                            <ColumnDefinition Width="{StaticResource ColRosterDtps}" />
                                                            <ColumnDefinition Width="{StaticResource ColRosterDied}" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="1" Style="{StaticResource HeaderText}" Text="PLAYER" />
                                                        <TextBlock Grid.Column="2" Style="{StaticResource HeaderText}" Text="CLASS" />
                                                        <TextBlock Grid.Column="3" Style="{StaticResource HeaderText}" Text="SPEC" />
                                                        <TextBlock Grid.Column="4" Style="{StaticResource HeaderText}" Text="DPS"
                                                                   HorizontalAlignment="Right" Margin="0,0,14,0" />
                                                        <TextBlock Grid.Column="5" Style="{StaticResource HeaderText}" Text="HPS"
                                                                   HorizontalAlignment="Right" Margin="0,0,14,0" />
                                                        <TextBlock Grid.Column="6" Style="{StaticResource HeaderText}" Text="DTPS"
                                                                   HorizontalAlignment="Right" Margin="0,0,14,0"
                                                                   ToolTip="Damage taken per second" />
                                                        <TextBlock Grid.Column="7" Style="{StaticResource HeaderText}" Text="DIED"
                                                                   HorizontalAlignment="Right" Margin="0,0,14,0" />
                                                        <TextBlock Grid.Column="8" Style="{StaticResource HeaderText}" Text="KILLED BY"
                                                                   ToolTip="Damage taken over the last 10 seconds before each death" />
                                                    </Grid>

                                                    <ItemsControl ItemsSource="{Binding Players}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{StaticResource InputBrush}" CornerRadius="3"
                                                                        Height="26" Margin="0,0,0,1">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="{StaticResource ColRosterIndent}" />
                                                                            <ColumnDefinition Width="{StaticResource ColRosterName}" />
                                                                            <ColumnDefinition Width="{StaticResource ColRosterClass}" />
                                                                            <ColumnDefinition Width="{StaticResource ColRosterSpec}" />
                                                                            <ColumnDefinition Width="{StaticResource ColRosterDps}" />
                                                                            <ColumnDefinition Width="{StaticResource ColRosterHps}" />
                                                                            <ColumnDefinition Width="{StaticResource ColRosterDtps}" />
                                                                            <ColumnDefinition Width="{StaticResource ColRosterDied}" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding Name}"
                                                                                   Margin="0,0,10,0"
                                                                                   ToolTip="{Binding Name}" />
                                                                        <TextBlock Grid.Column="2" Style="{StaticResource MutedText}"
                                                                                   Text="{Binding ClassName}" Margin="0,0,10,0" />
                                                                        <TextBlock Grid.Column="3" Style="{StaticResource MutedText}"
                                                                                   Text="{Binding SpecName}" Margin="0,0,10,0" />
                                                                        <TextBlock Grid.Column="4" Style="{StaticResource NumberText}"
                                                                                   Text="{Binding DpsText}" />
                                                                        <TextBlock Grid.Column="5" Style="{StaticResource NumberText}"
                                                                                   Text="{Binding HpsText}" />
                                                                        <TextBlock Grid.Column="6" Style="{StaticResource NumberText}"
                                                                                   Text="{Binding DtpsText}" />
                                                                        <TextBlock x:Name="DiedCell"
                                                                                   Grid.Column="7"
                                                                                   Style="{StaticResource NumberText}"
                                                                                   Foreground="{StaticResource MutedBrush}"
                                                                                   Text="{Binding DeathsText}" />
                                                                        <TextBlock Grid.Column="8"
                                                                                   Style="{StaticResource MutedText}"
                                                                                   Text="{Binding CausesText}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Margin="0,0,6,0"
                                                                                   ToolTip="{Binding CausesTooltip}"
                                                                                   ToolTipService.ShowDuration="60000" />
                                                                    </Grid>
                                                                </Border>

                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Died}" Value="True">
                                                                        <Setter TargetName="DiedCell" Property="Foreground"
                                                                                Value="{StaticResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Border Height="8" Background="Transparent" />
                                                </StackPanel>
                                            </StackPanel>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                    <Setter TargetName="ResultCell" Property="Foreground"
                                                            Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="6" Background="Transparent" />
                            </StackPanel>
                        </StackPanel>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasKill}" Value="True">
                                <Setter TargetName="KillCell" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasKill}" Value="False">
                                <Setter TargetName="KillCell" Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ===== footer ===== -->
        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource LinkButton}" Content="Select all"
                        Command="{Binding SelectAllCommand}" />
                <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="Clear"
                        Command="{Binding SelectNoneCommand}" />
                <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="Expand all"
                        Command="{Binding ExpandAllCommand}" />
                <Button Grid.Column="3" Style="{StaticResource LinkButton}" Content="Collapse all"
                        Command="{Binding CollapseAllCommand}" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="16,0,0,0">
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Grid.Column="5" Style="{StaticResource MutedText}" Text="{Binding SelectionText}"
                           Margin="0,0,16,0" />

                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <CheckBox Content="as single file" IsChecked="{Binding AsSingleFile, Mode=TwoWay}"
                              Margin="0,0,16,0"
                              ToolTip="Write every selected pull into a single file" />
                    <Button Content="Export" Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
