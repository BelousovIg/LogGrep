<Window x:Class="LogGrep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LogGrep.ViewModels"
        xmlns:ctl="clr-namespace:LogGrep.Controls"
        Title="LogGrep — WoW combat log splitter"
        Icon="Assets/app.ico"
        Height="760" Width="1280"
        MinHeight="480" MinWidth="980"
        Background="{StaticResource WindowBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        AllowDrop="True"
        DragOver="OnDragOver"
        Drop="OnDrop">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== toolbar ===== -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- Back and forward over everything the window does, not just the report:
                         a trail that handles some moves and not others is one people stop trusting.
                         The side buttons of a mouse do the same thing. -->
                    <Button Content="&#x2190;" MinWidth="34" Height="32" Margin="0,0,4,0"
                            Command="{Binding BackCommand}"
                            ToolTip="Back (mouse button 4)" />
                    <Button Content="&#x2192;" MinWidth="34" Height="32" Margin="0,0,12,0"
                            Command="{Binding ForwardCommand}"
                            ToolTip="Forward (mouse button 5)" />

                    <Button Content="Open log"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding OpenCommand}" />
                </StackPanel>

                <!-- The list of open logs, not a path: the app reads a set of files, and a box with
                     one path in it could only ever describe the first of them. -->
                <ToggleButton Grid.Column="1"
                              Margin="12,0,12,0"
                              HorizontalAlignment="Left"
                              MinWidth="140"
                              Height="32"
                              IsChecked="{Binding LogsExpanded, Mode=TwoWay}"
                              Content="{Binding LogsSummary}" />

                <Button Grid.Column="2"
                        Content="Settings"
                        Margin="0,0,12,0"
                        MinWidth="96"
                        Height="32"
                        Click="OnOpenSettings"
                        ToolTip="Where things are kept, and the Blizzard client the rules are built with" />

                <Button Grid.Column="3"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <!-- ===== the logs that are open ===== -->
        <Border Grid.Row="1"
                Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="16,8"
                Visibility="{Binding LogsExpanded, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Height="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Style="{StaticResource MutedText}" Text="FILE" />
                    <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                               Margin="0,0,14,0" Text="PULLS" />
                    <TextBlock Grid.Column="2" Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                               Margin="0,0,14,0" Text="ENCOUNTERS" />
                    <TextBlock Grid.Column="3" Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                               Margin="0,0,14,0" Text="FIRST PULL" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Logs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="200" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Path}"
                                       ToolTipService.ShowDuration="60000" />

                            <TextBlock Grid.Column="1" Style="{StaticResource NumberText}"
                                       Text="{Binding PullsText}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource NumberText}"
                                       Text="{Binding EncountersText}" />
                            <TextBlock Grid.Column="3" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Margin="0,0,14,0"
                                       Text="{Binding StartedText}" />

                            <Button Grid.Column="4" Style="{StaticResource LinkButton}"
                                    Content="Remove"
                                    Click="OnRemoveLog"
                                    ToolTip="Take this file out and read what is left" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <ProgressBar Grid.Row="2" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" />

        <!-- The three things the window is for, kept apart. Browsing and cutting a log is one job,
             reading a report is another, and saying who counts as ours is a third; one screen trying
             to be all of them is how the table filled up with things nobody opened it to read. -->
        <TabControl Grid.Row="3" Grid.RowSpan="2" Style="{StaticResource Screens}"
                    SelectedIndex="{Binding Screen, Mode=TwoWay}">
            <TabItem Header="LOGS">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

        <!-- ===== table header ===== -->
        <Border Grid.Row="0" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="16,0,16,0" Height="34">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource ColToggle}" />
                    <ColumnDefinition Width="{StaticResource ColCheck}" />
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=EncounterName}" MinWidth="150" />
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=EncounterDifficulty}" MinWidth="60" />
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=EncounterPulls}" MinWidth="60" />
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=EncounterResult}" MinWidth="60" />
                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=EncounterParty}" MinWidth="60" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=EncounterMistakes}" MinWidth="60" />
                </Grid.ColumnDefinitions>

                <ctl:SortHeader Grid.Column="2" Column="Name" Title="ENCOUNTER"
                                Sort="{Binding Sorting.Encounters}" />
                <ctl:SortHeader Grid.Column="3" Column="Difficulty" Title="DIFFICULTY"
                                Sort="{Binding Sorting.Encounters}" />
                <ctl:SortHeader Grid.Column="4" Column="Pulls" Title="PULLS"
                                Sort="{Binding Sorting.Encounters}"
                                HorizontalContentAlignment="Right" Padding="0,0,14,0" />
                <ctl:SortHeader Grid.Column="5" Column="Result" Title="RESULT"
                                Sort="{Binding Sorting.Encounters}"
                                HorizontalContentAlignment="Right" Padding="0,0,14,0" />
                <ctl:SortHeader Grid.Column="6" Column="Party" Title="PARTY SIZE"
                                Sort="{Binding Sorting.Encounters}"
                                HorizontalContentAlignment="Right" Padding="0,0,14,0"
                                ToolTip="Largest group size seen across the attempts" />
                <TextBlock Grid.Column="7" Style="{StaticResource MutedText}" Text="ANALYSE"
                           HorizontalAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center"
                           ToolTip="Open the report on this fight. Everything it measures is drawn from all of its attempts" />

                <GridSplitter Grid.Column="2" Style="{StaticResource ColumnSplitter}" />
                <GridSplitter Grid.Column="3" Style="{StaticResource ColumnSplitter}" />
                <GridSplitter Grid.Column="4" Style="{StaticResource ColumnSplitter}" />
                <GridSplitter Grid.Column="5" Style="{StaticResource ColumnSplitter}" />
                <GridSplitter Grid.Column="6" Style="{StaticResource ColumnSplitter}" />
            </Grid>
        </Border>

        <!-- ===== encounters ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="16,0,16,0">
            <ItemsControl ItemsSource="{Binding EncountersView}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,2">

                            <!-- encounter row -->
                            <Border Background="{StaticResource RowBrush}" CornerRadius="5" Height="38">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource ColToggle}" />
                                        <ColumnDefinition Width="{StaticResource ColCheck}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=EncounterName}" MinWidth="150" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=EncounterDifficulty}" MinWidth="60" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=EncounterPulls}" MinWidth="60" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=EncounterResult}" MinWidth="60" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=EncounterParty}" MinWidth="60" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=EncounterMistakes}" MinWidth="60" />
                                    </Grid.ColumnDefinitions>

                                    <ToggleButton Grid.Column="0"
                                                  Style="{StaticResource ExpanderToggle}"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsExpandable}"
                                                  ToolTip="Show the pulls of this encounter" />

                                    <CheckBox Grid.Column="1"
                                              IsThreeState="False"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              ToolTip="Select every pull of this encounter" />

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,12,0"
                                               ToolTip="{Binding Name}" />

                                    <TextBlock Grid.Column="3" Style="{StaticResource MutedText}" Text="{Binding DifficultyText}" />

                                    <TextBlock Grid.Column="4" Style="{StaticResource NumberText}" Text="{Binding PullCountText}" />

                                    <TextBlock x:Name="KillCell"
                                               Grid.Column="5"
                                               Style="{StaticResource NumberText}"
                                               Text="{Binding KillText}" />

                                    <TextBlock Grid.Column="6" Style="{StaticResource NumberText}" Text="{Binding PartySizeText}" />
                                    <Button Grid.Column="7" Style="{StaticResource LinkButton}"
                                            Content="Analyse" HorizontalAlignment="Right" Margin="0,0,8,0"
                                            Click="OnAnalyse"
                                            ToolTip="Open the report on this fight, measured over all of its attempts" />
                                </Grid>
                            </Border>

                            <!-- pulls -->
                            <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">

                                <Grid Height="26" Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource ColPullIndent}" />
                                        <ColumnDefinition Width="{StaticResource ColCheck}" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullResult}" MinWidth="60" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullStart}" MinWidth="60" />
                                        <ColumnDefinition Width="*" MinWidth="40" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullDuration}" MinWidth="60" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullPlayers}" MinWidth="60" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullDps}" MinWidth="60" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullHps}" MinWidth="60" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullMistakes}" MinWidth="60" />
                                    </Grid.ColumnDefinitions>
                                    <ctl:SortHeader Grid.Column="2" Column="Result" Title="RESULT"
                                                    Sort="{Binding Sorting.Pulls}" />
                                    <ctl:SortHeader Grid.Column="3" Column="Started" Title="STARTED"
                                                    Sort="{Binding Sorting.Pulls}" />
                                    <ctl:SortHeader Grid.Column="5" Column="Duration" Title="DURATION"
                                                    Sort="{Binding Sorting.Pulls}"
                                                    HorizontalContentAlignment="Right" Padding="0,0,14,0" />
                                    <ctl:SortHeader Grid.Column="6" Column="Players" Title="PLAYERS"
                                                    Sort="{Binding Sorting.Pulls}"
                                                    HorizontalContentAlignment="Right" Padding="0,0,14,0" />
                                    <ctl:SortHeader Grid.Column="7" Column="Dps" Title="DPS"
                                                    Sort="{Binding Sorting.Pulls}"
                                                    HorizontalContentAlignment="Right" Padding="0,0,14,0" />
                                    <ctl:SortHeader Grid.Column="8" Column="Hps" Title="HPS"
                                                    Sort="{Binding Sorting.Pulls}"
                                                    HorizontalContentAlignment="Right" Padding="0,0,14,0" />
                                    <TextBlock Grid.Column="9" Style="{StaticResource MutedText}" Text="ANALYSE"
                                               HorizontalAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center"
                                               ToolTip="Open the report on this attempt, measured against all the attempts at this fight" />

                                    <GridSplitter Grid.Column="2" Style="{StaticResource ColumnSplitter}" />
                                    <GridSplitter Grid.Column="3" Style="{StaticResource ColumnSplitter}" />
                                    <GridSplitter Grid.Column="5" Style="{StaticResource ColumnSplitter}" />
                                    <GridSplitter Grid.Column="6" Style="{StaticResource ColumnSplitter}" />
                                    <GridSplitter Grid.Column="7" Style="{StaticResource ColumnSplitter}" />
                                    <GridSplitter Grid.Column="8" Style="{StaticResource ColumnSplitter}" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding PullsView}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <Border Background="{StaticResource SubRowBrush}" CornerRadius="4"
                                                        Height="32" Margin="0,0,0,2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{StaticResource ColPullIndent}" />
                                                            <ColumnDefinition Width="{StaticResource ColCheck}" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullResult}" MinWidth="60" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullStart}" MinWidth="60" />
                                                            <ColumnDefinition Width="*" MinWidth="40" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullDuration}" MinWidth="60" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullPlayers}" MinWidth="60" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullDps}" MinWidth="60" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullHps}" MinWidth="60" />
                                        <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PullMistakes}" MinWidth="60" />
                                                        </Grid.ColumnDefinitions>

                                                        <ToggleButton Grid.Column="0"
                                                                      Style="{StaticResource ExpanderToggle}"
                                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                      IsEnabled="{Binding HasPlayers}"
                                                                      ToolTip="Show every player of this pull" />

                                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                                        <TextBlock x:Name="ResultCell"
                                                                   Grid.Column="2"
                                                                   Text="{Binding ResultText}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource DangerBrush}" />

                                                        <TextBlock Grid.Column="3" Style="{StaticResource MutedText}"
                                                                   Text="{Binding StartText}" />


                                                        <TextBlock Grid.Column="5" Style="{StaticResource NumberText}"
                                                                   Text="{Binding DurationText}" />
                                                        <TextBlock Grid.Column="6" Style="{StaticResource NumberText}"
                                                                   Text="{Binding ParticipantsText}" />
                                                        <TextBlock Grid.Column="7" Style="{StaticResource NumberText}"
                                                                   Text="{Binding DpsText}" />
                                                        <TextBlock Grid.Column="8" Style="{StaticResource NumberText}"
                                                                   Text="{Binding HpsText}" />
                                                        <Button Grid.Column="9" Style="{StaticResource LinkButton}"
                                                                Content="Analyse" HorizontalAlignment="Right"
                                                                Margin="0,0,8,0"
                                                                Click="OnAnalyse"
                                                                ToolTip="Open the report on this attempt, measured against all the attempts at this fight" />
                                                    </Grid>
                                                </Border>

                                                <!-- Who was in this attempt, and nothing about how
                                                     they played. This screen is for finding a fight
                                                     and cutting it out of the file; the report has a
                                                     screen of its own, one click away on every row. -->
                                                <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">

                                                    <Grid Height="24">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{StaticResource ColRosterIndent}" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerName}" MinWidth="60" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerClass}" MinWidth="60" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerSpec}" MinWidth="60" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerDps}" MinWidth="60" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerHps}" MinWidth="60" />
                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerDtps}" MinWidth="60" />
                                                            <ColumnDefinition Width="*" MinWidth="80" />
                                                        </Grid.ColumnDefinitions>

                                                        <ctl:SortHeader Grid.Column="1" Column="Name" Title="PLAYER"
                                                                        Sort="{Binding Sorting.Players}" />
                                                        <ctl:SortHeader Grid.Column="2" Column="Class" Title="CLASS"
                                                                        Sort="{Binding Sorting.Players}" />
                                                        <ctl:SortHeader Grid.Column="3" Column="Spec" Title="SPEC"
                                                                        Sort="{Binding Sorting.Players}" />
                                                        <ctl:SortHeader Grid.Column="4" Column="Dps" Title="DPS"
                                                                        Sort="{Binding Sorting.Players}"
                                                                        HorizontalContentAlignment="Right" Padding="0,0,14,0" />
                                                        <ctl:SortHeader Grid.Column="5" Column="Hps" Title="HPS"
                                                                        Sort="{Binding Sorting.Players}"
                                                                        HorizontalContentAlignment="Right" Padding="0,0,14,0" />
                                                        <ctl:SortHeader Grid.Column="6" Column="Dtps" Title="DTPS"
                                                                        Sort="{Binding Sorting.Players}"
                                                                        HorizontalContentAlignment="Right" Padding="0,0,14,0"
                                                                        ToolTip="Damage taken per second" />

                                                        <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}" />
                                                        <GridSplitter Grid.Column="2" Style="{StaticResource ColumnSplitter}" />
                                                        <GridSplitter Grid.Column="3" Style="{StaticResource ColumnSplitter}" />
                                                        <GridSplitter Grid.Column="4" Style="{StaticResource ColumnSplitter}" />
                                                        <GridSplitter Grid.Column="5" Style="{StaticResource ColumnSplitter}" />
                                                        <GridSplitter Grid.Column="6" Style="{StaticResource ColumnSplitter}" />
                                                    </Grid>

                                                    <ItemsControl ItemsSource="{Binding PlayersView}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{StaticResource InputBrush}" CornerRadius="3"
                                                                        Height="26" Margin="0,0,0,1">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="{StaticResource ColRosterIndent}" />
                                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerName}" MinWidth="60" />
                                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerClass}" MinWidth="60" />
                                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerSpec}" MinWidth="60" />
                                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerDps}" MinWidth="60" />
                                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerHps}" MinWidth="60" />
                                                                            <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerDtps}" MinWidth="60" />
                                                                            <ColumnDefinition Width="*" MinWidth="80" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <Button Grid.Column="1"
                                                                                Style="{StaticResource NameButton}"
                                                                                Content="{Binding Name}"
                                                                                Margin="0,0,10,0"
                                                                                Click="OnCopyPlayerName"
                                                                                ToolTip="{Binding FullName}"
                                                                                AutomationProperties.Name="Copy the full name" />
                                                                        <!-- Sits in the indent column, which lines up under the
                                                                             checkbox of the attempt this table belongs to. -->
                                                                        <Path x:Name="RoleMark"
                                                                              Grid.Column="0"
                                                                              Width="11" Height="11"
                                                                              Stretch="Uniform"
                                                                              HorizontalAlignment="Right"
                                                                              VerticalAlignment="Center"
                                                                              Margin="0,0,8,0"
                                                                              Visibility="Collapsed" />

                                                                        <TextBlock Grid.Column="2" Style="{StaticResource MutedText}"
                                                                                   Text="{Binding ClassName}" Margin="0,0,10,0"
                                                                                   Foreground="{Binding ClassBrush}" />
                                                                        <TextBlock Grid.Column="3" Style="{StaticResource MutedText}"
                                                                                   Text="{Binding SpecName}" Margin="0,0,10,0" />
                                                                        <TextBlock Grid.Column="4" Style="{StaticResource NumberText}"
                                                                                   Text="{Binding DpsText}" />
                                                                        <TextBlock Grid.Column="5" Style="{StaticResource NumberText}"
                                                                                   Text="{Binding HpsText}" />
                                                                        <TextBlock Grid.Column="6" Style="{StaticResource NumberText}"
                                                                                   Text="{Binding DtpsText}" />

                                                                        <Button Grid.Column="7" Style="{StaticResource LinkButton}"
                                                                                Content="Analyse" HorizontalAlignment="Right"
                                                                                Margin="0,0,8,0"
                                                                                Click="OnAnalyse"
                                                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                                                ToolTip="Open the report on this person in this attempt" />
                                                                    </Grid>
                                                                </Border>

                                                                <DataTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTank}" Value="True">
                                                                        <Setter TargetName="RoleMark" Property="Visibility" Value="Visible" />
                                                                        <Setter TargetName="RoleMark" Property="Data"
                                                                                Value="{StaticResource TankShield}" />
                                                                        <Setter TargetName="RoleMark" Property="Fill"
                                                                                Value="{StaticResource TankBrush}" />
                                                                        <Setter TargetName="RoleMark" Property="ToolTip" Value="Tank" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsHealer}" Value="True">
                                                                        <Setter TargetName="RoleMark" Property="Visibility" Value="Visible" />
                                                                        <Setter TargetName="RoleMark" Property="Data"
                                                                                Value="{StaticResource HealerCross}" />
                                                                        <Setter TargetName="RoleMark" Property="Fill"
                                                                                Value="{StaticResource HealerBrush}" />
                                                                        <Setter TargetName="RoleMark" Property="ToolTip" Value="Healer" />
                                                                    </DataTrigger>
                                                                </DataTemplate.Triggers>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Border Height="8" Background="Transparent" />
                                                </StackPanel>
                                            </StackPanel>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                    <Setter TargetName="ResultCell" Property="Foreground"
                                                            Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="6" Background="Transparent" />
                            </StackPanel>
                        </StackPanel>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasKill}" Value="True">
                                <Setter TargetName="KillCell" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasKill}" Value="False">
                                <Setter TargetName="KillCell" Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- The report. Everything it shows is measured over the whole encounter; what is on
                 screen is only what somebody narrowed down to, which is why drilling into one
                 attempt does not take the numbers away. -->
            <TabItem Header="ANALYSIS">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource WindowBrush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                            Padding="16,10,16,10">
                        <StackPanel>
                            <!-- The trail, as pieces to click. A report that can be drilled into and
                                 not climbed out of has a dead end in it, and the way back was already
                                 written here - it just was not doing anything. -->
                            <ItemsControl ItemsSource="{Binding Analysis.Crumbs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="Step" Style="{StaticResource LinkButton}"
                                                    Content="{Binding Text}" Click="OnClimbTo"
                                                    ToolTip="Back to this" />
                                            <TextBlock x:Name="Arrow" Style="{StaticResource MutedText}"
                                                       Text="  &#x203A;  " VerticalAlignment="Center" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Climbable}" Value="False">
                                                <Setter TargetName="Step" Property="IsEnabled" Value="False" />
                                                <Setter TargetName="Step" Property="Foreground"
                                                        Value="{StaticResource FgBrush}" />
                                                <Setter TargetName="Step" Property="ToolTip" Value="{x:Null}" />
                                                <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding Analysis.Breadcrumb}" Foreground="{StaticResource FgBrush}"
                                       Visibility="{Binding Analysis.HasNothing, Converter={StaticResource BoolToVis}}" />

                            <!-- What is being measured, and who it is about, kept on screen the whole
                                 time. Every figure below is a share of something, and two selections
                                 give the same person two different scores - which must never be able
                                 to look like a bug. -->
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Style="{StaticResource MutedText}" Text="WHAT" Width="46" />
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding Analysis.SampleText}"
                                           ToolTip="A selection made by a rule grows when the log does; one picked by hand does not" />
                                <Button Style="{StaticResource LinkButton}" Content="all" Margin="12,0,0,0"
                                        Click="OnAllAttempts" ToolTip="Every attempt in the selection" />
                                <Button Style="{StaticResource LinkButton}" Content="kills"
                                        Click="OnKillsOnly" ToolTip="Only the attempts that ended in a kill" />
                                <Button Style="{StaticResource LinkButton}" Content="wipes"
                                        Click="OnWipesOnly" ToolTip="Only the attempts that did not" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Style="{StaticResource MutedText}" Text="WHO" Width="46" />
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding Analysis.PeopleText}"
                                           ToolTip="Who counts as ours is set on the People tab" />
                                <Button Style="{StaticResource LinkButton}" Content="tanks" Margin="12,0,0,0"
                                        Click="OnOnlyTanks" ToolTip="Only the attempts somebody tanked" />
                                <Button Style="{StaticResource LinkButton}" Content="healers"
                                        Click="OnOnlyHealers" ToolTip="Only the attempts somebody healed" />
                                <Button Style="{StaticResource LinkButton}" Content="damage"
                                        Click="OnOnlyDamage" ToolTip="Only the attempts somebody spent on damage" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" Margin="16,16,16,0"
                               TextWrapping="Wrap"
                               Text="Open a log, then press Analyse on a fight, an attempt or a person."
                               Visibility="{Binding Analysis.HasNothing, Converter={StaticResource BoolToVis}}" />

                    <!-- Rows are who, columns are when. The four views of the report are states of
                         this one control rather than four screens: a row click changes who, a column
                         click changes when, and somebody learns to read it once. -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto" Padding="16,12,16,0"
                                  Visibility="{Binding Analysis.ShowGrid, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       Margin="0,0,0,8"
                                       Text="Each column is an attempt. A cell is what it cost that person, in their own health pools; a dot is an attempt they were not in, which is not the same as a clean one. Click a cell to open it." />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource MutedText}" Text="PLAYER" />
                                <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" Text="POOLS"
                                           HorizontalAlignment="Right" Margin="0,0,10,0"
                                           ToolTip="What the whole selection cost them, in their own health pools" />
                                <ItemsControl Grid.Column="2" ItemsSource="{Binding Analysis.Grid.Columns}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource MutedText}" Width="30"
                                                       TextAlignment="Center" Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Analysis.Grid.Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Style="{StaticResource MutedText}"
                                                       Foreground="{Binding ClassBrush}"
                                                       Text="{Binding Name}" Margin="0,0,10,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding FullName}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource NumberText}"
                                                       Text="{Binding PoolsText}"
                                                       ToolTip="{Binding PresenceText}" />

                                            <ItemsControl Grid.Column="2" ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Width="28" Height="20" Margin="1"
                                                                Style="{StaticResource CellButton}"
                                                                Background="{Binding Paint}"
                                                                Content="{Binding Text}"
                                                                Click="OnOpenCell"
                                                                ToolTip="{Binding Tooltip}"
                                                                ToolTipService.ShowDuration="60000" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Height="12" Background="Transparent" />
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="16,12,16,0"
                                  Visibility="{Binding Analysis.HasPull, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding Analysis.Pull}">

                            <!-- The shape of the attempt: how far down the enemy went, and how many
                                 of the group were still up. Two lines on one clock, and between them
                                 they tell the story a table cannot. -->
                            <Border Background="{StaticResource InputBrush}" CornerRadius="3"
                                    Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <ctl:FightShape Height="96"
                                                    Traces="{Binding Traces}"
                                                    Deaths="{Binding Deaths}"
                                                    Kills="{Binding Kills}"
                                                    From="{Binding From, Mode=TwoWay}"
                                                    To="{Binding To, Mode=TwoWay}" />

                                    <!-- One switch per line. They share a clock and nothing else,
                                         so being able to take three of them away is what makes the
                                         fourth readable. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <ItemsControl ItemsSource="{Binding Traces}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                              Margin="0,0,16,0"
                                                              Foreground="{Binding Paint}"
                                                              Content="{Binding Name}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Which stretch is being read, and the way out of it. The
                                             rates in the table below are over this window, so saying
                                             what it is matters more than the drag that set it. -->
                                        <!-- The two marks that are not lines, so nobody has to work
                                             out what a small shape at the edge of a chart means. -->
                                        <TextBlock Style="{StaticResource MutedText}" Text="✕ death"
                                                   VerticalAlignment="Center"
                                                   Foreground="#FFE0706D" Margin="0,0,10,0"
                                                   ToolTip="A skull along the bottom, where somebody went down" />
                                        <TextBlock Style="{StaticResource MutedText}" Text="★ kill"
                                                   VerticalAlignment="Center"
                                                   Foreground="#FF8FC7F0"
                                                   Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}}"
                                                   ToolTip="A star along the top, where the enemy went down" />

                                        <TextBlock Style="{StaticResource MutedText}"
                                                   VerticalAlignment="Center" Margin="8,0,8,0"
                                                   Text="{Binding WindowText}"
                                                   ToolTip="Drag across the chart to read one stretch of the fight" />
                                        <Button Style="{StaticResource LinkButton}" Content="whole attempt"
                                                VerticalAlignment="Center"
                                                Click="OnResetWindow"
                                                Visibility="{Binding IsWindowed, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Back to the whole attempt. A double-click on the chart does the same" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- The attempt's own card. Not an average of the players below it: an
                                 average hides the one person who lost the pull behind nineteen who
                                 did not, so this is the loss itself, and then who it went to. -->
                            <ItemsControl ItemsSource="{Binding Axes}" Margin="0,0,0,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource InputBrush}" CornerRadius="3"
                                                Margin="0,0,6,0" Padding="10,5,10,5"
                                                ToolTip="{Binding Facts}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource MutedText}"
                                                           Text="{Binding Axis}" Margin="0,0,10,0" />
                                                <TextBlock Style="{StaticResource MutedText}"
                                                           Foreground="{StaticResource FgBrush}"
                                                           Text="{Binding Text}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding ShownText}"
                                       Margin="0,0,0,4" TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding PoolsText}"
                                       Margin="0,0,0,6"
                                       ToolTip="Everything the attempt cost, counted in the players' own health pools" />

                            <ItemsControl ItemsSource="{Binding Blame}" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                                            <TextBlock Style="{StaticResource MutedText}" Width="150"
                                                       Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource MutedText}" Width="90"
                                                       Foreground="{StaticResource DangerBrush}"
                                                       Text="{Binding PoolsText}" />
                                            <TextBlock Style="{StaticResource MutedText}"
                                                       Text="{Binding Headline}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- The enemy's own lane, on the same axis as every player's below it, so
                                 a cause stands directly over its consequence. The bands are the
                                 moments one thing caught much of the group at once. -->
                            <Grid Height="18" Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource ColAnalysisRole}" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerName}" MinWidth="60" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerClass}" MinWidth="60" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerSpec}" MinWidth="60" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerDps}" MinWidth="60" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerHps}" MinWidth="60" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerDtps}" MinWidth="60" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerOutput}" MinWidth="44" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerSurvival}" MinWidth="44" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerMechanics}" MinWidth="44" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerDuty}" MinWidth="44" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerMistakes}" MinWidth="80" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerLane}" MinWidth="120" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="1" Style="{StaticResource MutedText}"
                                           Text="{Binding Record.EncounterName}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                           ToolTip="What the enemy cast, and where the group was caught together" />
                                <ctl:FightLane Grid.Column="12"
                                               Marks="{Binding EnemyMarks}"
                                               Bands="{Binding Collective}"
                                               Seconds="{Binding Seconds}"
                                               Margin="6,0,6,0" />
                            </Grid>

                            <Grid Height="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource ColAnalysisRole}" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerName}" MinWidth="60" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerClass}" MinWidth="60" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerSpec}" MinWidth="60" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerDps}" MinWidth="60" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerHps}" MinWidth="60" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerDtps}" MinWidth="60" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerOutput}" MinWidth="44" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerSurvival}" MinWidth="44" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerMechanics}" MinWidth="44" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerDuty}" MinWidth="44" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerMistakes}" MinWidth="80" />
                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerLane}" MinWidth="120" />
                                </Grid.ColumnDefinitions>

                                <ctl:SortHeader Grid.Column="1" Column="Name" Title="PLAYER"
                                                Sort="{Binding Sorting.Players}" />
                                <ctl:SortHeader Grid.Column="2" Column="Class" Title="CLASS"
                                                Sort="{Binding Sorting.Players}" />
                                <ctl:SortHeader Grid.Column="3" Column="Spec" Title="SPEC"
                                                Sort="{Binding Sorting.Players}" />

                                <!-- The same three rates as the logs tab, in the same order, but
                                     read over whatever stretch of the fight the chart above is
                                     showing. A rate over a window somebody chose is a different
                                     number from a rate over the pull, and this is where they see
                                     which one they are looking at. -->
                                <ctl:SortHeader Grid.Column="4" Column="Dps" Title="DPS"
                                                Sort="{Binding Sorting.Players}"
                                                HorizontalContentAlignment="Right" Padding="0,0,14,0" />
                                <ctl:SortHeader Grid.Column="5" Column="Hps" Title="HPS"
                                                Sort="{Binding Sorting.Players}"
                                                HorizontalContentAlignment="Right" Padding="0,0,14,0" />
                                <ctl:SortHeader Grid.Column="6" Column="Dtps" Title="DTPS"
                                                Sort="{Binding Sorting.Players}"
                                                HorizontalContentAlignment="Right" Padding="0,0,14,0"
                                                ToolTip="Damage taken per second" />
                                <ctl:SortHeader Grid.Column="7" Column="Output" Title="OUT"
                                                Sort="{Binding Sorting.Players}"
                                                HorizontalContentAlignment="Right" Padding="0,0,10,0"
                                                ToolTip="Damage, or healing for a healer, against the best they have shown on this fight" />
                                <ctl:SortHeader Grid.Column="8" Column="Survival" Title="SRV"
                                                Sort="{Binding Sorting.Players}"
                                                HorizontalContentAlignment="Right" Padding="0,0,10,0"
                                                ToolTip="Of everything that hit them, how much was not theirs to avoid" />
                                <ctl:SortHeader Grid.Column="9" Column="Mechanics" Title="MCH"
                                                Sort="{Binding Sorting.Players}"
                                                HorizontalContentAlignment="Right" Padding="0,0,10,0"
                                                ToolTip="Of the times a mechanic went out, how often it missed them" />
                                <ctl:SortHeader Grid.Column="10" Column="Duty" Title="DTY"
                                                Sort="{Binding Sorting.Players}"
                                                HorizontalContentAlignment="Right" Padding="0,0,10,0"
                                                ToolTip="The job the role was there to do: threat for a tank, deaths held for a healer, uptime for the rest" />
                                <ctl:SortHeader Grid.Column="11" Column="Mistakes" Title="WORST"
                                                Sort="{Binding Sorting.Players}"
                                                ToolTip="The most expensive thing that happened to them. Sorted by what the attempt cost them, in health pools" />
                                <StackPanel Grid.Column="12" Orientation="Horizontal" Margin="6,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource MutedText}" Text="THE FIGHT" Margin="0,0,12,0" />

                                    <!-- The legend. The lane says everything with a shape and a
                                       colour, and a language nobody is taught is a language nobody
                                       reads. -->
                                    <TextBlock Style="{StaticResource MutedText}" Text="● mechanic"
                                               Foreground="#FFE0A554" Margin="0,0,10,0" />
                                    <TextBlock Style="{StaticResource MutedText}" Text="▲ interrupt"
                                               Foreground="#FF8E9BE8" Margin="0,0,10,0" />
                                    <TextBlock Style="{StaticResource MutedText}" Text="● idle"
                                               Foreground="#FF9096A0" Margin="0,0,10,0" />
                                    <TextBlock Style="{StaticResource MutedText}" Text="✕ death"
                                               Foreground="#FFE0706D" Margin="0,0,10,0" />
                                    <TextBlock Style="{StaticResource MutedText}" Text="○ caught the group"
                                               ToolTip="A hollow mark is one thing that caught much of the group, not one person's mistake" />
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding PlayersView}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource InputBrush}" CornerRadius="3"
                                                Height="26" Margin="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{StaticResource ColAnalysisRole}" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerName}" MinWidth="60" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerClass}" MinWidth="60" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerSpec}" MinWidth="60" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerDps}" MinWidth="60" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerHps}" MinWidth="60" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerDtps}" MinWidth="60" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerOutput}" MinWidth="44" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerSurvival}" MinWidth="44" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerMechanics}" MinWidth="44" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerDuty}" MinWidth="44" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerMistakes}" MinWidth="80" />
                                                    <ColumnDefinition Width="{Binding Source={x:Static vm:ColumnLayout.Current}, Mode=TwoWay, Path=PlayerLane}" MinWidth="120" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Tank or healer, marked the way the logs tab marks
                                                     them. The rest carry no mark there either: an
                                                     icon on everybody says nothing about anybody. -->
                                                <Path x:Name="RoleMark"
                                                      Grid.Column="0"
                                                      Width="11" Height="11"
                                                      Stretch="Uniform"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Visibility="Collapsed" />

                                                <TextBlock Grid.Column="1" Style="{StaticResource MutedText}"
                                                           Foreground="{Binding ClassBrush}"
                                                           Text="{Binding Name}" Margin="0,0,10,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FullName}" />
                                                <TextBlock Grid.Column="2" Style="{StaticResource MutedText}"
                                                           Text="{Binding ClassName}" Margin="0,0,10,0"
                                                           Foreground="{Binding ClassBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Style="{StaticResource MutedText}"
                                                           Text="{Binding SpecName}" Margin="0,0,10,0"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="4" Style="{StaticResource NumberText}"
                                                           Text="{Binding DpsText}" />
                                                <TextBlock Grid.Column="5" Style="{StaticResource NumberText}"
                                                           Text="{Binding HpsText}" />
                                                <TextBlock Grid.Column="6" Style="{StaticResource NumberText}"
                                                           Text="{Binding DtpsText}" />
                                                <TextBlock Grid.Column="7" Style="{StaticResource NumberText}"
                                                           Text="{Binding OutputText}"
                                                           ToolTip="{Binding OutputTooltip}"
                                                           ToolTipService.ShowDuration="60000" />
                                                <TextBlock Grid.Column="8" Style="{StaticResource NumberText}"
                                                           Text="{Binding SurvivalText}"
                                                           ToolTip="{Binding SurvivalTooltip}"
                                                           ToolTipService.ShowDuration="60000" />
                                                <TextBlock Grid.Column="9" Style="{StaticResource NumberText}"
                                                           Text="{Binding MechanicsText}"
                                                           ToolTip="{Binding MechanicsTooltip}"
                                                           ToolTipService.ShowDuration="60000" />
                                                <TextBlock Grid.Column="10" Style="{StaticResource NumberText}"
                                                           Text="{Binding DutyText}"
                                                           ToolTip="{Binding DutyTooltip}"
                                                           ToolTipService.ShowDuration="60000" />

                                                <!-- One sentence, not a list. A list in a cell does
                                                     not survive a fourteenth rule being added; a
                                                     maximum does. -->
                                                <TextBlock x:Name="WorstCell"
                                                           Grid.Column="11"
                                                           Style="{StaticResource MutedText}"
                                                           Text="{Binding WorstText}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,6,0"
                                                           ToolTip="{Binding MistakesTooltip}"
                                                           ToolTipService.ShowDuration="60000" />

                                                <ctl:FightLane Grid.Column="12"
                                                               Marks="{Binding Marks}"
                                                               Seconds="{Binding Seconds}"
                                                               Margin="6,0,6,0" />
                                            </Grid>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasWorst}" Value="True">
                                                <Setter TargetName="WorstCell" Property="Foreground"
                                                        Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsTank}" Value="True">
                                                <Setter TargetName="RoleMark" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="RoleMark" Property="Data"
                                                        Value="{StaticResource TankShield}" />
                                                <Setter TargetName="RoleMark" Property="Fill"
                                                        Value="{StaticResource TankBrush}" />
                                                <Setter TargetName="RoleMark" Property="ToolTip" Value="Tank" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsHealer}" Value="True">
                                                <Setter TargetName="RoleMark" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="RoleMark" Property="Data"
                                                        Value="{StaticResource HealerCross}" />
                                                <Setter TargetName="RoleMark" Property="Fill"
                                                        Value="{StaticResource HealerBrush}" />
                                                <Setter TargetName="RoleMark" Property="ToolTip" Value="Healer" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Height="12" Background="Transparent" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ===== the people the logs have seen ===== -->
            <TabItem Header="PEOPLE">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource WindowBrush}" Padding="16,10,16,10">
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding PeopleSummary}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource WindowBrush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                            Padding="16,0,16,0" Height="30">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" MinWidth="120" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Style="{StaticResource MutedText}" Text="OURS"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" Text="CHARACTER"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Style="{StaticResource MutedText}" Text="REALM"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Style="{StaticResource MutedText}" Text="CLASS"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Style="{StaticResource MutedText}" Text="ROLES PLAYED"
                                       VerticalAlignment="Center"
                                       ToolTip="More than one means they respecced. What they were is a property of each attempt, not of the person" />
                            <TextBlock Grid.Column="5" Style="{StaticResource MutedText}" Text="PULLS"
                                       HorizontalAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="6" Style="{StaticResource MutedText}" Text="BOSSES"
                                       HorizontalAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="7" Style="{StaticResource MutedText}" Text="LAST SEEN"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="16,0,16,0">
                        <ItemsControl ItemsSource="{Binding People}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource RowBrush}" CornerRadius="3"
                                            Height="28" Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" MinWidth="120" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsOurs, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="10,0,0,0"
                                                      ToolTip="Whether this character is one of ours" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource MutedText}"
                                                       Foreground="{Binding ClassBrush}"
                                                       Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,10,0" ToolTip="{Binding FullName}" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource MutedText}"
                                                       Text="{Binding Realm}" TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="3" Style="{StaticResource MutedText}"
                                                       Text="{Binding ClassName}" TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="4" Style="{StaticResource MutedText}"
                                                       Text="{Binding RolesText}" TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,10,0" ToolTip="{Binding SpecsText}" />
                                            <TextBlock Grid.Column="5" Style="{StaticResource NumberText}"
                                                       Text="{Binding PullsText}" />
                                            <TextBlock Grid.Column="6" Style="{StaticResource NumberText}"
                                                       Text="{Binding EncountersText}" />
                                            <TextBlock Grid.Column="7" Style="{StaticResource MutedText}"
                                                       Text="{Binding LastSeenText}"
                                                       ToolTip="{Binding SeenTooltip}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="5" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The buttons belong to whatever screen is open. "Select all" meant the attempts
                     even while the registry was showing, which is a button lying about what it does. -->
                <StackPanel Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal"
                            Visibility="{Binding OnLogs, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource LinkButton}" Content="Select all"
                            Command="{Binding SelectAllCommand}" />
                    <Button Style="{StaticResource LinkButton}" Content="Clear"
                            Command="{Binding SelectNoneCommand}" />
                    <Button Style="{StaticResource LinkButton}" Content="Expand all"
                            Command="{Binding ExpandAllCommand}" />
                    <Button Style="{StaticResource LinkButton}" Content="Collapse all"
                            Command="{Binding CollapseAllCommand}" />

                    <!-- What the detectors found goes out as one file per player, which is how anybody
                         reads it: nobody wants the whole night, they want their own part of it. -->
                    <Button Style="{StaticResource LinkButton}" Content="Save report"
                            Command="{Binding ExportFindingsCommand}" ToolTip="{Binding FindingsSummary}" />

                    <!-- Exactly the attempts that are ticked, which is how somebody says "these ten
                         of the thirty-one". A set picked by hand does not grow when the log does. -->
                    <Button Style="{StaticResource LinkButton}" Content="Analyse selected"
                            Click="OnAnalyseSelected"
                            ToolTip="Open the report on the attempts that are ticked, and only those" />
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal"
                            Visibility="{Binding OnPeople, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource LinkButton}" Content="All ours"
                            Command="{Binding AllOursCommand}"
                            ToolTip="Count every character the logs have seen" />
                    <Button Style="{StaticResource LinkButton}" Content="None ours"
                            Command="{Binding NoneOursCommand}"
                            ToolTip="Set everybody aside, then tick back the ones you want" />
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Left" Margin="16,0,0,0">
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Grid.Column="6" Style="{StaticResource MutedText}" Text="{Binding SelectionText}"
                           Margin="0,0,16,0"
                           Visibility="{Binding OnLogs, Converter={StaticResource BoolToVis}}" />

                <StackPanel Grid.Column="7" Orientation="Horizontal"
                            Visibility="{Binding OnLogs, Converter={StaticResource BoolToVis}}">
                    <CheckBox Content="as single file" IsChecked="{Binding AsSingleFile, Mode=TwoWay}"
                              Margin="0,0,16,0"
                              ToolTip="Write every selected pull into a single file" />
                    <Button Content="Export" Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
