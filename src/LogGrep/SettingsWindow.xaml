<Window x:Class="LogGrep.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LogGrep — settings"
        Width="640"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <StackPanel Margin="20">

        <TextBlock Text="BLIZZARD API" Style="{StaticResource HeaderText}" />
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,14"
                   Text="A client from develop.battle.net lets the app build its rules from Blizzard's own
                         encounter journal. Nothing here is required: without it the app uses the rules it
                         shipped with, and opening a log never touches the network either way." />

        <TextBlock Text="Client id" Margin="0,0,0,4" />
        <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="Region" Margin="0,0,0,4" />
        <TextBox Text="{Binding Region, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                 ToolTip="eu, us, kr or tw - it decides which copy of the journal is read" />

        <TextBlock Text="Client secret" Margin="0,0,0,4" />
        <PasswordBox x:Name="Secret" Margin="0,0,0,4" />
        <TextBlock Style="{StaticResource MutedText}" Text="{Binding SecretState}" Margin="0,0,0,4" />
        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,18"
                   Text="The secret is encrypted for this Windows account before it is written, so the file
                         is useless on another machine or to another user." />

        <TextBlock Text="WHERE THINGS ARE KEPT" Style="{StaticResource HeaderText}" />

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource MutedText}" Text="Folder" />
            <TextBox Grid.Row="0" Grid.Column="1" IsReadOnly="True" Margin="0,0,8,6"
                     Text="{Binding DataDirectory, Mode=OneWay}" ToolTip="{Binding DataDirectory}" />
            <Button Grid.Row="0" Grid.Column="2" Content="Open" Margin="0,0,0,6"
                    Command="{Binding OpenFolderCommand}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource MutedText}" Text="Settings" />
            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource MutedText}"
                       Margin="0,0,0,6" TextTrimming="CharacterEllipsis"
                       Text="{Binding SettingsPath, Mode=OneWay}" ToolTip="{Binding SettingsPath}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource MutedText}" Text="Rules" />
            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource MutedText}"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding RulesPath, Mode=OneWay}"
                       ToolTip="Where the rules built from the journal will go. Nothing writes it yet." />
        </Grid>

        <TextBlock Style="{StaticResource MutedText}" Text="{Binding Status}" TextWrapping="Wrap"
                   Margin="0,16,0,0" />

        <Grid Margin="0,20,0,0">
            <Button HorizontalAlignment="Left"
                    Content="Build rules from the journal"
                    IsEnabled="{Binding CanBuild}"
                    Click="OnBuildRules"
                    ToolTip="Saves what is here, then reads the journal and writes the rules file" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" MinWidth="90" Margin="0,0,10,0" Click="OnCancel" />
                <Button Content="Save" MinWidth="90" Style="{StaticResource PrimaryButton}" Click="OnSave" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
